+// supportsAdditionalTelemetryProperties handles the edition suffix GitLab appends
+// to release versions (for example, "19.4.0-ee").
+func supportsAdditionalTelemetryProperties(instanceVersion string) bool {
+	numericVersion, _, _ := strings.Cut(instanceVersion, "-")
+	parts := strings.Split(numericVersion, ".")
+	if len(parts) < 2 {
+		return false
+	}
+
+	major, err := strconv.Atoi(parts[0])
+	if err != nil {
+		return false
+	}
+	minor, err := strconv.Atoi(parts[1])
+	if err != nil {
+		return false
+	}
+
+	return major > additionalTelemetryPropertiesMinMajor ||
+		(major == additionalTelemetryPropertiesMinMajor && minor >= additionalTelemetryPropertiesMinMinor)
+}
