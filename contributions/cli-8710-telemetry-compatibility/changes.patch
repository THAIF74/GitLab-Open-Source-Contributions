+func Test_supportsAdditionalTelemetryProperties(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name    string
+		version string
+		want    bool
+	}{
+		{name: "older minor release", version: "18.11.6-ee", want: false},
+		{name: "previous minor release", version: "19.3.9-ee", want: false},
+		{name: "minimum supported release", version: "19.4.0-ee", want: true},
+		{name: "newer release", version: "19.6.0-ee", want: true},
+		{name: "future major release", version: "20.0.0-ee", want: true},
+		{name: "unknown version", version: "", want: false},
+		{name: "malformed version", version: "not-a-version", want: false},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			assert.Equal(t, tt.want, supportsAdditionalTelemetryProperties(tt.version))
+		})
+	}
+}
