+// serverSupportsAdditionalTelemetryProperties checks whether the target instance
+// supports the additional_properties field before glab sends it.
+func serverSupportsAdditionalTelemetryProperties(client *gitlab.Client, options ...gitlab.RequestOptionFunc) bool {
+	metadata, _, err := client.Metadata.GetMetadata(options...)
+	if err != nil {
+		dbg.Debug("Could not get GitLab metadata for telemetry: ", err.Error())
+		return false
+	}
